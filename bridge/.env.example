# Copy to `.env` (gitignored) and fill in MQTT_PASSWORD. mqtt_bridge.py auto-loads
# the .env sitting next to it. CLI flags override these.

SERIAL_PORT=/dev/serial/by-id/usb-Raspberry_Pi_Pico_2-if00   # macOS: /dev/tty.usbmodem*
MQTT_BROKER=mqtt.8bitcloud.com
MQTT_PORT=1883
MQTT_USER=lights
MQTT_PASSWORD=changeme

# Instance id: this becomes BOTH the MQTT topic prefix AND the HA unique_id /
# device-identifier prefix. Use a DISTINCT value per gateway so several bridges
# share one broker without colliding. The main lighting system uses "lighting".
MQTT_PREFIX=testrig
# Human label prefixed to HA device names so you can tell instances apart.
NODE_NAME=Test Rig
